<?xml version="1.0"?>
<configuration>

  <!--
    CONNECTION STRING
    Default: Visual Studio LocalDB (installed with Visual Studio's ASP.NET workload).
    If you use SQL Server Express instead, replace Data Source with .\SQLEXPRESS
    If you use full SQL Server, use your server name.
    Do not commit real passwords here. Prefer Integrated Security=True.
  -->
  <connectionStrings>
    <add name="DineBookConnection"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=DineBookDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Required: client-side validation without a jQuery ScriptResourceMapping. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <sessionState mode="InProc" timeout="30" cookieless="UseCookies" />
    <httpCookies httpOnlyCookies="true" />
    <!-- Set mode="On" (or "RemoteOnly") when you deploy, so users never see stack traces. -->
    <customErrors mode="RemoteOnly" />
  </system.web>

</configuration>
